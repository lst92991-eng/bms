{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BMS_ENGINEERING_BUILD": "ON"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BMS_ENGINEERING_BUILD": "OFF"
      }
    },
    {
      "name": "gcc-engineering",
      "displayName": "GCC Engineering",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-engineering",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BMS_ENGINEERING_BUILD": "ON"
      }
    },
    {
      "name": "host-msvc",
      "displayName": "Host Tests (MSVC)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/host-msvc",
      "cacheVariables": {
        "BMS_HOST_TESTS_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-engineering",
      "configurePreset": "gcc-engineering"
    },
    {
      "name": "host-msvc",
      "configurePreset": "host-msvc",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "host-msvc",
      "configurePreset": "host-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
